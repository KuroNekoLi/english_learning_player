rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validAsset(uid, assetId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'ownerId', 'assetId', 'sha256', 'byteLength',
          'mediaType', 'storagePath', 'opId', 'payloadHash'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'ownerId', 'assetId', 'sha256', 'byteLength',
          'mediaType', 'storagePath', 'opId', 'payloadHash'
        ])
        && data.schemaVersion == 1
        && data.ownerId == uid
        && data.assetId == assetId
        && data.sha256 is string && data.sha256.matches('^[a-f0-9]{64}$')
        && data.byteLength is int && data.byteLength > 0
        && data.byteLength <= 104857600
        && data.mediaType in ['audio/mpeg', 'audio/mp4']
        && data.storagePath == 'users/' + uid + '/assets/' + assetId + '/' + data.sha256
        && data.opId is string && data.opId.size() > 0
        && data.payloadHash is string && data.payloadHash.matches('^[a-f0-9]{64}$');
    }

    function validMaterial(uid, materialId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'ownerId', 'materialId', 'title', 'audioAssetId',
          'assetSha256', 'byteLength', 'mediaType', 'storagePath', 'opId',
          'payloadHash', 'status'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'ownerId', 'materialId', 'title', 'audioAssetId',
          'assetSha256', 'byteLength', 'mediaType', 'storagePath', 'opId',
          'payloadHash', 'status'
        ])
        && data.schemaVersion == 1
        && data.ownerId == uid
        && data.materialId == materialId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 500
        && data.audioAssetId is string && data.audioAssetId.size() > 0
        && data.assetSha256 is string && data.assetSha256.matches('^[a-f0-9]{64}$')
        && data.byteLength is int && data.byteLength > 0
        && data.byteLength <= 104857600
        && data.mediaType in ['audio/mpeg', 'audio/mp4']
        && data.storagePath == 'users/' + uid + '/assets/' + data.audioAssetId + '/' + data.assetSha256
        && data.opId is string && data.opId.size() > 0
        && data.payloadHash is string && data.payloadHash.matches('^[a-f0-9]{64}$')
        && data.status == 'cloudReady';
    }

    match /users/{uid}/mediaAssets/{assetId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validAsset(uid, assetId);
      allow update: if isOwner(uid) && validAsset(uid, assetId)
        && request.resource.data == resource.data;
      allow delete: if false;
    }

    match /users/{uid}/materials/{materialId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validMaterial(uid, materialId)
        && exists(/databases/$(database)/documents/users/$(uid)/mediaAssets/$(request.resource.data.audioAssetId));
      allow update: if isOwner(uid) && validMaterial(uid, materialId)
        && request.resource.data == resource.data;
      allow delete: if false;
    }

    match /users/{uid}/materials/{materialId}/subtitleTracks/{language} {
      function validSubtitle() {
        let data = request.resource.data;
        return language in ['en', 'zh']
          && data.keys().hasOnly([
            'schemaVersion', 'ownerId', 'materialId', 'languageTag', 'sha256',
            'byteLength', 'revision', 'offsetMs', 'storagePath', 'cueProjection'
          ])
          && data.schemaVersion == 1 && data.ownerId == uid && data.materialId == materialId
          && data.languageTag is string
          && data.languageTag.matches('^' + language + '(-[a-z0-9]{2,8})*$')
          && data.sha256 is string && data.sha256.matches('^[a-f0-9]{64}$')
          && data.byteLength is int && data.byteLength > 0 && data.byteLength <= 2097152
          && data.revision is int && data.revision > 0 && data.offsetMs is int
          && data.get('cueProjection', 'original') in ['original', 'bilingual']
          && data.storagePath == 'users/' + uid + '/subtitles/' + materialId + '/' + data.sha256;
      }

      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validSubtitle()
        && exists(/databases/$(database)/documents/users/$(uid)/materials/$(materialId));
      allow delete: if false;
    }

    match /users/{uid}/libraryChanges/{changeId} {
      function validChange() {
        let data = request.resource.data;
        let keys = ['ownerId', 'schemaVersion', 'field', 'entityId', 'value', 'revision', 'opId'];
        return data.keys().hasOnly(keys) && data.keys().hasAll(keys)
          && data.ownerId == uid && data.schemaVersion == 1
          && data.entityId is string && data.entityId.matches('^[A-Za-z0-9_-]{1,128}$')
          && changeId == data.field + '_' + data.entityId
          && data.revision is int && data.revision > 0 && data.revision <= 9007199254740991
          && data.opId is string && data.opId.matches('^[a-f0-9-]{36}$')
          && data.value is string
          && ((data.field in ['folderName', 'materialTitle']
                && data.value.size() > 0 && data.value.size() <= 80)
            || (data.field == 'folderParent'
                && (data.value == '' || data.value.matches('^[A-Za-z0-9_-]{1,128}$'))
                && data.value != data.entityId)
            || (data.field == 'materialFolders' && data.value.size() <= 32768
                && data.value.matches('^\\[("[A-Za-z0-9_-]{1,128}"(,"[A-Za-z0-9_-]{1,128}")*)?\\]$'))
            || (data.field in ['folderDeleted', 'materialDeleted'] && data.value == '1'));
      }

      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validChange();
      allow update: if isOwner(uid) && validChange()
        && request.resource.data.revision >= resource.data.revision;
      allow delete: if false;
    }

    match /users/{uid}/progress/{materialId} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
