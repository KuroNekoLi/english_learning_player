# Copy to .env.firebase-auth (gitignored); fill from your Firebase project.
# Never put Apple private keys or Firebase Admin credentials here.
ELP_FIREBASE_PROJECT=english-learning-player-auth
ELP_FIREBASE_BUCKET=<project-id>.firebasestorage.app
ELP_FIREBASE_API_KEY=
# Public config returned by the Firebase Web app registration.
ELP_FIREBASE_WEB_APP_ID=
ELP_FIREBASE_MESSAGING_SENDER_ID=
# Defaults to <project>.firebaseapp.com when omitted.
ELP_FIREBASE_AUTH_DOMAIN=
ELP_GOOGLE_SERVER_CLIENT_ID=
ELP_GOOGLE_IOS_CLIENT_ID=
ELP_GOOGLE_MACOS_CLIENT_ID=
ELP_GOOGLE_DESKTOP_CLIENT_ID=
# Optional for Google Desktop OAuth clients. Desktop secrets are public-client values.
ELP_GOOGLE_DESKTOP_CLIENT_SECRET=
ELP_FIREBASE_ANDROID_APP_ID=
ELP_ENABLE_APPLE_SIGN_IN=false
# ELP_FIREBASE_PROGRESS_REGION=
